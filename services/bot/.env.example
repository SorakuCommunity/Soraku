SPOTIFY_SECRET=


# ═══════════════════════════════════════════════════════════════════════════════
# [9] MULTIPLE WEBHOOKS — Kirim ke banyak channel
# ═══════════════════════════════════════════════════════════════════════════════
# Cara dapat webhook:
# 1. Buka channel → Channel Settings → Integrations → Webhooks
# 2. Create Webhook → Pilih channel → Copy URL
#
# Contoh: WH_EVENTS=https://discord.com/api/webhooks/xxx/yyy

# Webhook utama (default/fallback)
WEBHOOK=

# Specific webhooks per用途:
WH_EVENTS=       # Event notifications
WH_BLOG=         # Blog/Artikel baru
WH_FEEDBACK=     # Feedback submissions
WH_DONATION=     # Donasi/Payment notifications
WH_GALLERY=      # Gallery uploads
WH_MODERATION=   # Moderation actions
WH_MUSIC=        # Music bot activities
WH_JOINLEAVE=    # Member join/leave

# Alternative: Multiple webhooks comma-separated (akan dikirim ke semua)
# WEBHOOKS=https://discord.com/api/webhooks/1,https://discord.com/api/webhooks/2


# ═══════════════════════════════════════════════════════════════════════════════
# [10] WEBHOOK SETTINGS — OPSIONAL
# ═══════════════════════════════════════════════════════════════════════════════
WEBHOOK_ENABLED=true
WEBHOOK_USERNAME=Soraku Bot
# WEBHOOK_AVATAR_URL=

# Enable/disable specific log levels
# WEBHOOK_INFO_ENABLED=true
# WEBHOOK_SUCCESS_ENABLED=true
# WEBHOOK_WARNING_ENABLED=true
# WEBHOOK_ERROR_ENABLED=true
# WEBHOOK_DEBUG_ENABLED=false


# ═══════════════════════════════════════════════════════════════════════════════
# [11] LAST.FM — OPSIONAL
# ═══════════════════════════════════════════════════════════════════════════════
# LASTFM_KEY=


# =============================================================================
# CONTOH PENGGUNAAN
# =============================================================================
#
# Cara 1: Satu webhook ke banyak channel (via broadcast)
#   WEBHOOK=https://discord.com/api/webhooks/xxx/yyy
#   → Semua notifikasi dikirim ke webhook ini
#
# Cara 2: Specific webhooks per用途
#   WH_EVENTS=https://discord.com/api/webhooks/events/xxx
#   WH_BLOG=https://discord.com/api/webhooks/blog/yyy
#   WH_FEEDBACK=https://discord.com/api/webhooks/feedback/zzz
#   → Setiap тип notification ke webhook berbeda
#
# Cara 3: Multiple webhooks (semua dapat semua notifikasi)
#   WEBHOOKS=https://webhook1,https://webhook2,https://webhook3
#   → Semua notifikasi dikirim ke semua webhook
#
# =============================================================================