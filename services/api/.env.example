# ============================================================
# SORAKU API SERVICE — Environment Variables
# File    : services/api/.env.example
# Copy    : cp services/api/.env.example services/api/.env.local
# Deploy  : Vercel → Project apisoraku → Settings → Environment Variables
#
# ⚠  JANGAN commit .env.local ke Git
# ============================================================

# ─────────────────────────────────────────────────────────────
# [1] DATABASE  (WAJIB — Drizzle ORM)
# ─────────────────────────────────────────────────────────────
# Supabase Transaction Pooler (port 6543, bukan 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres

# Komunitas DB (soraku-komunitas: jrgknsxqwuygcoocnnnb)
DATABASE_URL=

# Streaming DB (soraku-streaming: qrplumamxikcxvaerlug)
STREAMING_DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# [2] SUPABASE  (WAJIB)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://jrgknsxqwuygcoocnnnb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# [3] SECRET — AUTH ANTAR SERVICE  (WAJIB)
# ─────────────────────────────────────────────────────────────
# Harus SAMA di: services/api, apps/web, services/bot
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SORAKU_API_SECRET=

# ─────────────────────────────────────────────────────────────
# [4] CORS  (Opsional)
# ─────────────────────────────────────────────────────────────
# Comma-separated origins yang diizinkan
# Contoh: https://soraku.vercel.app,https://stream.soraku.vercel.app
# Kosongkan = allow all (aman untuk development)
CORS_ORIGINS=https://soraku.vercel.app,https://stream.soraku.vercel.app,http://localhost:3000,http://localhost:3001

# ─────────────────────────────────────────────────────────────
# [5] ANIME STREAMING  (Opsional)
# ─────────────────────────────────────────────────────────────
# Self-host (recommended): docker run -p 3000:3000 ghcr.io/consumet/consumet-api
# Public (rate-limited):   https://api.consumet.org
CONSUMET_API_URL=https://api.consumet.org

# ─────────────────────────────────────────────────────────────
# [6] PAYMENT  (Opsional)
# ─────────────────────────────────────────────────────────────
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
TRAKTEER_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# [7] UPSTASH REDIS  (Opsional — untuk caching)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────
# [8] RUNTIME
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
