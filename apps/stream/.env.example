# Soraku Stream - Environment Variables
# ======================================

# API Configuration
# Use the centralized Soraku API
NEXT_PUBLIC_API_URL=https://apisoraku.vercel.app

# Supabase Auth (for user authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API Keys (if needed for specific features)
API_KEY=
API_BEARER_TOKEN=

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://appsoraku.vercel.app
BASE_URL=https://appsoraku.vercel.app

# Admin Configuration
ADMIN_USERNAMES= Riu
ADMIN_USERNAME= Riu

# Redis (optional - for caching)
REDIS_URL=

# Proxy (optional - for bypassing CORS)
PROXY_URI=
