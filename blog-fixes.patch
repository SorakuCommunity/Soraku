From 110b94bf36f90b094a024e33a5e17f7a94d6467a Mon Sep 17 00:00:00 2001
From: "Bubu (Soraku FE)" <bubu@soraku.id>
Date: Wed, 18 Mar 2026 11:14:18 +0000
Subject: [PATCH 1/4] fix(blog): RefObject<HTMLTextAreaElement | null> compat
 React 19 strict mode
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Error: Argument of type 'RefObject<HTMLTextAreaElement | null>' is not
assignable to parameter of type 'RefObject<HTMLTextAreaElement>'

Root cause: React 19 useRef() returns RefObject<T | null> secara default,
tapi insertMarkdown() masih pakai signature lama RefObject<HTMLTextAreaElement>
(tanpa null), tidak kompatibel dengan TypeScript strict.

Fix: Update signature insertMarkdown di kedua file:
  blog/[id]/edit/page.tsx line 25
  blog/new/page.tsx line 25

  RefObject<HTMLTextAreaElement>  →  RefObject<HTMLTextAreaElement | null>
---
 apps/web/src/app/(dashboard)/admin/blog/[id]/edit/page.tsx | 2 +-
 apps/web/src/app/(dashboard)/admin/blog/new/page.tsx       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/apps/web/src/app/(dashboard)/admin/blog/[id]/edit/page.tsx b/apps/web/src/app/(dashboard)/admin/blog/[id]/edit/page.tsx
index ee0a0c9..3e7779c 100644
--- a/apps/web/src/app/(dashboard)/admin/blog/[id]/edit/page.tsx
+++ b/apps/web/src/app/(dashboard)/admin/blog/[id]/edit/page.tsx
@@ -22,7 +22,7 @@ function ToolbarBtn({ icon: Icon, label, onClick }: { icon: any; label: string;
   );
 }
 
-function insertMarkdown(ref: React.RefObject<HTMLTextAreaElement>, setValue: (v: string) => void, before: string, after = "", placeholder = "teks") {
+function insertMarkdown(ref: React.RefObject<HTMLTextAreaElement | null>, setValue: (v: string) => void, before: string, after = "", placeholder = "teks") {
   const el = ref.current;
   if (!el) return;
   const start = el.selectionStart, end = el.selectionEnd;
diff --git a/apps/web/src/app/(dashboard)/admin/blog/new/page.tsx b/apps/web/src/app/(dashboard)/admin/blog/new/page.tsx
index 5f0b378..1928003 100644
--- a/apps/web/src/app/(dashboard)/admin/blog/new/page.tsx
+++ b/apps/web/src/app/(dashboard)/admin/blog/new/page.tsx
@@ -22,7 +22,7 @@ function ToolbarBtn({ icon: Icon, label, onClick }: { icon: any; label: string;
   );
 }
 
-function insertMarkdown(ref: React.RefObject<HTMLTextAreaElement>, setValue: (v: string) => void, before: string, after = "", placeholder = "teks") {
+function insertMarkdown(ref: React.RefObject<HTMLTextAreaElement | null>, setValue: (v: string) => void, before: string, after = "", placeholder = "teks") {
   const el = ref.current;
   if (!el) return;
   const start = el.selectionStart;
-- 
