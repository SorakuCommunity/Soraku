{
  "name": "soraku",
  "version": "1.6.0",
  "private": true,
  "description": "Soraku Ecosystem — Build once, connect everything.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SorakuCommunity/Soraku"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @soraku/web dev",
    "dev:stream": "pnpm --filter @soraku/stream dev",
    "dev:api": "pnpm --filter @soraku/api dev",
    "dev:bot": "pnpm --filter soraku-bot dev",
    "build": "turbo build",
    "build:web": "pnpm --filter @soraku/web build",
    "build:stream": "pnpm --filter @soraku/stream build",
    "build:api": "pnpm --filter @soraku/api build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.8.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
