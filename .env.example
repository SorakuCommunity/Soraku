# =============================================================================
# SORAKU ECOSYSTEM — Environment Variables
# =============================================================================
# 
# Naming Convention:
# - NEXT_PUBLIC_* = Client-side di Next.js (web, stream)
# - SUPABASE_* = Supabase (SUPABASE_URL, SUPABASE_KEY, SUPABASE_SERVICE_KEY)
# - SORAKU_* = Soraku API (SORAKU_URL, SORAKU_SECRET)
# - (Langsung)* = Discord (TOKEN, CLIENT_ID, GUILD_ID, OWNER_IDS)
# - DB_* = Database (DB_URL, DB_STREAM_URL)
# - LAVA_* = Lavalink
# - XENDIT_* = Payment
# - TRAKTEER_* = Donation
# - REDIS_* = Cache
# - Others = Utility
#
# ⚠️ JANGAN commit .env ke Git!
# =============================================================================


# ═══════════════════════════════════════════════════════════════════════════════
# SHARED / COMMON
# ═══════════════════════════════════════════════════════════════════════════════

# Supabase (Komunitas Project: jrgknsxqwuygcoocnnnb)
SUPABASE_URL=https://jrgknsxqwuygcoocnnnb.supabase.co
SUPABASE_KEY=          # anon key (client-side)
SUPABASE_SERVICE_KEY=  # service_role key (server-side only!)

# Soraku API (Central)
SORAKU_URL=https://apisoraku.vercel.app
SORAKU_SECRET=        # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


# ═══════════════════════════════════════════════════════════════════════════════
# SERVICES/API — Central REST API (Next.js)
# Port: 4000 | Deploy: https://apisoraku.vercel.app
# ═══════════════════════════════════════════════════════════════════════════════

# Database (Drizzle ORM)
DB_URL=           # Komunitas DB
DB_STREAM_URL=    # Streaming DB

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000,https://soraku.vercel.app,https://stream.soraku.id

# Anime Scraper
CONSUMET_API_URL=https://api.consumet.org

# Payment
XENDIT_KEY=
XENDIT_WEBHOOK=
TRAKTEER_SECRET=

# Redis Cache
REDIS_URL=
REDIS_TOKEN=

# Runtime
NODE_ENV=development


# ═══════════════════════════════════════════════════════════════════════════════
# APPS/WEB — Komunitas Platform (Next.js)
# Port: 3000 | Deploy: https://soraku.vercel.app
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SITE_URL=https://soraku.vercel.app
NEXT_PUBLIC_APP_URL=https://soraku.vercel.app

# Database
DB_URL=

# Soraku API
NEXT_PUBLIC_SORAKU_URL=https://apisoraku.vercel.app

# Bot Communication
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=

# Umami Analytics
UMAMI_API_TOKEN=umami_xxxxxxxxxxxxx

# Payment
XENDIT_KEY=
XENDIT_WEBHOOK=
TRAKTEER_SECRET=

# Discord
OWNER_IDS=1020644780075659356
DISCORD_INVITE=qm3XJvRa6B
NEXT_PUBLIC_DISCORD_INVITE=qm3XJvRa6B


# ═══════════════════════════════════════════════════════════════════════════════
# APPS/STREAM — Anime Streaming (Next.js)
# Port: 3001 | Deploy: https://stream.soraku.id
# ═══════════════════════════════════════════════════════════════════════════════

NEXT_PUBLIC_SORAKU_URL=https://apisoraku.vercel.app
NEXT_PUBLIC_SITE_URL=https://stream.soraku.id
BASE_URL=https://stream.soraku.id

# Supabase (Auth)
NEXT_PUBLIC_SUPABASE_URL=https://jrgknsxqwuygcoocnnnb.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=

# Admin
ADMIN_USERS=

# Redis
REDIS_URL=

# Proxy
PROXY_URI=


# ═══════════════════════════════════════════════════════════════════════════════
# APPS/MOBILE — Mobile App (Expo)
# ═══════════════════════════════════════════════════════════════════════════════

EXPO_PUBLIC_SORAKU_URL=https://apisoraku.vercel.app
EXPO_PUBLIC_SUPABASE_URL=https://jrgknsxqwuygcoocnnnb.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=
EXPO_PUBLIC_APP_NAME=Soraku


# ═══════════════════════════════════════════════════════════════════════════════
# SERVICES/BOT — Discord Bot
# Deploy: Render/Fly.io
# ═══════════════════════════════════════════════════════════════════════════════

# Discord
TOKEN=
CLIENT_ID=
GUILD_ID=1116971049045729302
OWNER_IDS=1020644780075659356

# Soraku API
SORAKU_URL=https://apisoraku.vercel.app
SORAKU_SECRET=

# Web Integration
WEB_URL=https://soraku.vercel.app
WEBHOOK=
CHANNEL_ID=

# Supabase
SUPABASE_URL=https://jrgknsxqwuygcoocnnnb.supabase.co
SUPABASE_KEY=

# Roles
ROLE_DONATUR=1436534227708543046
ROLE_VIP=1447194092965728307
ROLE_VVIP=1447194196401459320

# Lavalink/Music
