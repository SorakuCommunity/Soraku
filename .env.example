STATUS_TYPE=online
NODE_ENV=production
PORT=8080
TOTAL_SHARDS=auto

# Spotify
SPOTIFY_ID=
SPOTIFY_SECRET=


# =============================================================================
# QUICK REFERENCE - ENV NAME MIGRATION
# =============================================================================
#
# OLD → NEW (yang dipakai sekarang)
# ─────────────────────────────────────────────────────
# NEXT_PUBLIC_S_URL → NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_S_KEY → NEXT_PUBLIC_SUPABASE_KEY  
# S_URL → SUPABASE_URL
# S_KEY → SUPABASE_KEY
# S_SERVICE_KEY → SUPABASE_SERVICE_KEY
# SA_URL → SORAKU_URL
# SA_SECRET → SORAKU_SECRET
# NEXT_PUBLIC_SA_URL → NEXT_PUBLIC_SORAKU_URL
# D_TOKEN → TOKEN
# D_CLIENT_ID → CLIENT_ID
# D_GUILD_ID → GUILD_ID
# D_OWNER_IDS → OWNER_IDS
# D_INVITE → DISCORD_INVITE
# NEXT_PUBLIC_D_INVITE → NEXT_PUBLIC_DISCORD_INVITE
# LAVA_* → LAVA_*
# XENDIT_* → XENDIT_*
# TRAKTEER_* → TRAKTEER_*
# REDIS_* → REDIS_*
# BOT_WEBHOOK_* → BOT_WEBHOOK_*
# DB_URL → DB_URL
# DB_STREAM_URL → DB_STREAM_URL
#
# =============================================================================